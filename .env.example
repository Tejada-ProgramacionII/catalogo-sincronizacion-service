# Copiar a .env (no se commitea) y completar con los valores reales de la cuenta técnica.

# API REST de la cátedra y JWT técnico de la cuenta del proyecto.
CATEDRA_BASE_URL=http://catedra.example:8090
CATEDRA_JWT=jwt-tecnico-de-ejemplo

# Secreto HS512 de los JWT de usuario: el mismo valor que en turnos-reservas-service.
JWT_SECRET=secreto-base64-de-al-menos-64-bytes

# Redis de la cátedra (solo lectura en catedra:sync:*).
CATEDRA_REDIS_HOST=catedra.example
CATEDRA_REDIS_PORT=6379
CATEDRA_REDIS_USERNAME=grp_proyecto-ejemplo
CATEDRA_REDIS_PASSWORD=clave-de-ejemplo

# Kafka de la cátedra (avisos CatalogUpdated).
CATEDRA_KAFKA_BOOTSTRAP_SERVERS=catedra.example:9094
CATEDRA_KAFKA_CATALOG_TOPIC=catedra.catalog.proyecto-ejemplo
CATEDRA_KAFKA_CONSUMER_GROUP=alumnos-proyecto-ejemplo
